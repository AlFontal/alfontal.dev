---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  externalPosts,
  homeAnchorCards,
  homeHero,
  homePage,
  interestTags,
  personJsonLd,
  socialLinks,
  siteMeta,
} from '../data/content';
import portraitImage from '../assets/media/alejandro_hike_profile.jpg';

const profileSocialLinks = socialLinks.filter((link) => link.label !== 'Email');

const notebookPosts = (await getCollection('notebooks')).map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date.toISOString().slice(0, 10),
  href: `${entry.data.routePath}/`,
}));
const recentPosts = [...notebookPosts, ...externalPosts]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout jsonLd={personJsonLd}>
  <section class="hero-grid reveal-in">
    <article class="hero-card hero-stack">
      <p class="eyebrow">{homePage.eyebrow}</p>

      <h1>{homeHero.name}</h1>

      <ul class="portrait-socials hero-socials" aria-label="Contact and social links">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                aria-label={link.label}
                title={link.label}
              >
                <iconify-icon icon={link.icon} aria-hidden="true"></iconify-icon>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="hero-note">{homeHero.intro}</p>
      <p class="hero-tagline">{homeHero.tagline}</p>
      <p>
        {
          homeHero.moreInfo.map((segment) =>
            segment.href ? (
              <a
                href={segment.href}
                class="hero-note-link"
                target={segment.external ? '_blank' : undefined}
                rel={segment.external ? 'noopener noreferrer' : undefined}
              >{segment.text}</a>
            ) : (
              segment.text
            )
          )
        }
      </p>

      <div class="fact-grid" aria-label="Core focus areas">
        {
          homeHero.cards.map((card) => (
            <article class="fact-card">
              <h2>{card.title}</h2>
              <p>{card.subtitle}</p>
            </article>
          ))
        }
      </div>
    </article>

    <aside class="portrait-panel">
      <div class="portrait-stack">
        <div class="portrait-image">
          {/* Square crop of a 3:4 photo. The panel is hidden once the layout stacks (≤1080px);
              the 1px slot there makes the browser fetch only the smallest file. */}
          <Image
            src={portraitImage}
            alt="Alejandro Fontal hiking in front of Fitz Roy"
            widths={[480, 640, 960, 1280]}
            sizes="(max-width: 1080px) 1px, 320px"
            format="webp"
            quality={75}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="portrait-base"
          />
        </div>
        <div class="portrait-meta-cloud">
          <p class="portrait-contact">
            <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
          </p>
          <ul class="portrait-socials" aria-label="Social links">
            {
              profileSocialLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
                    <iconify-icon icon={link.icon} aria-hidden="true"></iconify-icon>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </aside>
  </section>

  <section class="split-layout reveal-in">
    <section class="block quick-paths-panel">
      <div class="pathway-list">
        {
          homeAnchorCards.map((card) => (
            <article class="pathway-card" id={card.id}>
              <span class="pathway-icon" aria-hidden="true">
                <iconify-icon icon={card.icon}></iconify-icon>
              </span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <a href={card.linkHref} class="inline-link">{card.linkLabel}</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <aside class="block" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 id="writing-heading">{homePage.recentWritingHeading}</h2>
      </div>

      <ol class="timeline timeline--plain">
        {
          recentPosts.map((post) => (
            <li>
              <article class="timeline-card recent-post">
                <header>
                  <h3>
                    <a href={post.href} class="recent-post-link">{post.title}</a>
                  </h3>
                  <span>{post.date}</span>
                </header>
                <p>{post.description}</p>
              </article>
            </li>
          ))
        }
      </ol>

      <a href="/blog/" class="inline-link recent-posts-all">{homePage.recentWritingLinkLabel}</a>
    </aside>
  </section>

  <section class="block domain-panel reveal-in" aria-labelledby="domains-heading">
    <div class="section-head">
      <h2 id="domains-heading">{homePage.interestsHeading}</h2>
    </div>
    <ul class="chip-list">
      {interestTags.map((tag) => <li>{tag}</li>)}
    </ul>
  </section>
</BaseLayout>
