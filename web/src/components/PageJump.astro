---
import type { PageJumpLink } from '../data/content';

interface Props {
  links: PageJumpLink[];
}

const { links } = Astro.props;
---

<nav class="page-jump" aria-label="Jump to section">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>
